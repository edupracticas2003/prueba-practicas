# 🛢️ CONFIGURACIÓN DE BASE DE DATOS MYSQL PROPIA DE LA APP
# =========================================================
DB_HOST_COM=
DB_USER_COM=
DB_PORT_COM=
DB_PASSWORD_COM=
DB_NAME_COM=

# 🛢️ CONFIGURACIÓN PANEL CMS
# ==========================
DB_HOST_DATA=
DB_USER_DATA=
DB_PORT_DATA=
DB_PASSWORD_DATA=

# 📡 CONFIGURACIÓN APIS SOLUM AIMS CORE
# =====================================
SOLUM_API_URL=https://

SOLUM_USER=
SOLUM_PASSWORD=

SOLUM_COMPANY=SIM
SOLUM_STORE=1024

DEBUG=true

# 🖼️ show-label visualization (CLI)
# =================================
# Directory where PNG previews are written (bind-mount this for host viewing).
SHOW_LABEL_IMAGE_DIR=/tmp/com-labels-images
# Container HTTP listen port (map -p 8765:8765 in Docker / docker-compose).
SHOW_LABEL_HTTP_PORT=8765
# Public base URL printed as ROOT LINK (reachable from your browser, not localhost).
# Prefer this when Docker runs on a remote server. Example for docker-compose / .env.com.labels:
#   SHOW_LABEL_PUBLIC_URL=http://<servidor>:8765
SHOW_LABEL_PUBLIC_URL=
# Alternative to PUBLIC_URL: host only (scheme http:// + SHOW_LABEL_HTTP_PORT are applied).
#   SHOW_LABEL_HOST=<servidor>
# SHOW_LABEL_HOST=
